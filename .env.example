# Flask Configuration
SECRET_KEY=college_ai_team_builder_secret_key_change_in_production
FLASK_ENV=development
FLASK_APP=run.py

# Database Configuration (MySQL)
# Example MySQL URI:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/teambuilder_db
# If MySQL is not running or DATABASE_URL is not set, the application automatically
# falls back to a local SQLite database (teambuilder.db) so faculty can test instantly!
DATABASE_URL=sqlite:///teambuilder.db

# Algorithm Weights Default (Sum should be 1.0)
WEIGHT_SKILL=0.40
WEIGHT_INTEREST=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_AVAILABILITY=0.15
WEIGHT_ROLE=0.10
